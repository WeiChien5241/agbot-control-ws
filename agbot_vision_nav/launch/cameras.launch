<launch>
  <!-- Real-robot camera bringup: existing front usb_cam + two new Logitech
       Brios. Each camera is a separate usb_cam node; the NODE NAME sets the
       topic prefix, so the three cameras publish:

         /usb_cam/image_raw            (+ /compressed)   existing camera
         /brio_left/image_raw          (+ /compressed)   new Brio #1
         /brio_right/image_raw         (+ /compressed)   new Brio #2

       The .../image_raw/compressed topics are created automatically by
       image_transport, so the existing training workflow
       (rosbag record <topic>/image_raw/compressed) works for all three.

       IMPORTANT — device paths: /dev/video0, /dev/video2, ... are assigned
       in plug-in order and can swap between boots. Pin each camera with its
       stable symlink instead. On the robot, run:

         ls -l /dev/v4l/by-id/

       If both Brios show identical by-id names (Logitech doesn't always
       expose distinct serials), use /dev/v4l/by-path/ instead — those names
       encode the physical USB port, so they stay stable as long as each
       camera keeps its port. Then pass the real paths as launch args or
       edit the defaults below.

       Example:
         roslaunch agbot_vision_nav cameras.launch \
           brio_left_device:=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:1:1.0-video-index0 \
           brio_right_device:=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2:1.0-video-index0

       To launch only the current camera (today's behavior):
         roslaunch agbot_vision_nav cameras.launch brio_left:=false brio_right:=false
  -->

  <!-- Per-camera enable switches -->
  <arg name="front"       default="true" />
  <arg name="brio_left"   default="true" />
  <arg name="brio_right"  default="true" />

  <!-- Device paths — REPLACE the Brio defaults with the by-id/by-path links
       found on the robot (see header comment). -->
  <arg name="front_device"      default="/dev/video0" />
  <arg name="brio_left_device"  default="/dev/v4l/by-path/CHANGE_ME_left-video-index0" />
  <arg name="brio_right_device" default="/dev/v4l/by-path/CHANGE_ME_right-video-index0" />

  <!-- Shared image settings: keep 640x480@30 so new footage matches the
       existing training data and the vision-nav input resolution. -->
  <arg name="width"  default="640" />
  <arg name="height" default="480" />
  <arg name="fps"    default="30" />

  <!-- Existing front camera, unchanged topic (/usb_cam/image_raw). -->
  <node if="$(arg front)" name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device"  value="$(arg front_device)" />
    <param name="image_width"   value="$(arg width)" />
    <param name="image_height"  value="$(arg height)" />
    <param name="framerate"     value="$(arg fps)" />
    <param name="pixel_format"  value="yuyv" />
    <param name="camera_frame_id" value="usb_cam" />
  </node>

  <!-- New Brio cameras. pixel_format mjpeg: the Brio compresses on-camera,
       which is what makes three cameras fit on USB bandwidth — raw YUYV
       from three devices on one bus will fail with "No space left on
       device" / select timeouts. usb_cam decodes MJPEG internally, so the
       published image_raw is still a normal uncompressed sensor_msgs/Image. -->
  <node if="$(arg brio_left)" name="brio_left" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device"  value="$(arg brio_left_device)" />
    <param name="image_width"   value="$(arg width)" />
    <param name="image_height"  value="$(arg height)" />
    <param name="framerate"     value="$(arg fps)" />
    <param name="pixel_format"  value="mjpeg" />
    <param name="camera_frame_id" value="brio_left" />
  </node>

  <node if="$(arg brio_right)" name="brio_right" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device"  value="$(arg brio_right_device)" />
    <param name="image_width"   value="$(arg width)" />
    <param name="image_height"  value="$(arg height)" />
    <param name="framerate"     value="$(arg fps)" />
    <param name="pixel_format"  value="mjpeg" />
    <param name="camera_frame_id" value="brio_right" />
  </node>
</launch>
