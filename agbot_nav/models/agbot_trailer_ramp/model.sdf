<?xml version="1.0"?>
<!-- Low-cost trailer WITH a ramp, so the sim can drive the trailer leg
     (reverse down the ramp) instead of spawning the robot at the ramp foot.
     Static: a solid deck box plus one tilted plank. No mesh.

     Model frame: origin on the ground at the deck's REAR edge (the ramp's
     top), +x = the trailer's heading (toward its front), +z up.
       deck   x in [0, 2.5], 1.6 m wide, top at z = 0.45
       ramp   1.5 m along the slope from (0, 0.45) down to the ground at
              x = -1.431  ->  17.5 deg (sin = 0.30)
     The robot parks on the deck facing +x and backs straight down the ramp.

     ⚠ PLACEHOLDER DIMENSIONS. The real trailer's deck height and ramp length
     are not known yet; change h / L here (plank pose maths below) when they
     are. With slope theta, plank length Lp (incl. 0.10 m buried at the foot),
     thickness t:
       top-surface centre = (-(Lp/2) cos theta, h - (Lp/2) sin theta)
       box centre         = top-surface centre - (t/2) * (-sin theta, cos theta)
       pitch              = -theta (raises the +x end)
     The plank's top edge sits exactly on the deck's rear edge so there is no
     lip for the wheels to catch. -->
<sdf version="1.6">
  <model name="agbot_trailer_ramp">
    <static>true</static>

    <link name="deck">
      <pose>1.25 0 0.225 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>2.5 1.6 0.45</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>2.5 1.6 0.45</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- h = 0.45, L = 1.5 (to the ground) + 0.10 buried = Lp 1.6, t = 0.04,
         theta = asin(0.30) = 0.304693 rad -->
    <link name="ramp">
      <pose>-0.757151 0 0.190921 0 -0.304693 0</pose>
      <collision name="collision">
        <geometry><box><size>1.6 1.2 0.04</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.6 1.2 0.04</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
