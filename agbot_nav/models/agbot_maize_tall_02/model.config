<?xml version="1.0"?>
<model>
  <name>AgBot tall maize 02</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    virtual_maize_field's maize_02 mesh at twice its scale (~1.26 m instead of
    ~0.63 m), for LiDAR tests: at the stock height the plants sit below the
    0.58 m sensor and are invisible to it beyond ~12 m. The mesh is
    referenced from virtual_maize_field, not copied.
    Mesh (c) 2021 Kamaro Engineering e.V., CC BY-SA 4.0.
  </description>
</model>
