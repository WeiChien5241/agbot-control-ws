<?xml version="1.0"?>
<!-- Stand-in for the deployment trailer: a static 4 x 2 x 1.2 m box, so the
     LiDAR sees a large object next to the drop-off point, as it will in the
     field. No ramp: the sim robot is spawned at the ramp foot. -->
<sdf version="1.6">
  <model name="agbot_trailer">
    <static>true</static>
    <link name="body">
      <pose>0 0 0.6 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>4.0 2.0 1.2</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>4.0 2.0 1.2</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
