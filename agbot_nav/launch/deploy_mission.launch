<launch>
  <!-- THE WHOLE DEPLOYMENT on the LiDAR stack:
         reverse off the trailer -> AMCL localizes -> move_base to the row
         entrance -> vision nav drives the rows -> move_base back to the
         drop-off point.
       Sequenced by deploy_supervisor.py (decisions in deploy_fsm.py).

       Sim (the `field` world, agbot_bringup/config/agbot_field_layout.yaml):
         rosrun agbot_bringup switch_maize_world.sh field
         roslaunch agbot_bringup agbot_gazebo.launch lidar:=true rviz:=false \
           x:=-7.92 y:=-1.30 z:=0.35 yaw:=1.5917
         roslaunch agbot_nav deploy_mission.launch sim:=true rviz:=true
       then in RViz: "2D Nav Goal" at a row mouth, arrow DOWN the row. The
       robot drives there, does num_rows rows, comes back, and waits for the
       next goal (status: rostopic echo /deploy_supervisor/status). Or start
       it from the operator panel (rosrun agbot_vision_nav operator_panel.py,
       section 5), which also sets num_rows and the speeds.
       The map/start defaults below are that world's. With your own SLAM map,
       pass map_file and initial_* (save_map.sh prints them).
       Scripted runs: pass entrance_x/_y/_yaw_deg and the goal is fixed, the
       run ends after the way home, and RViz goals are ignored
       (field world: entrance_x:=-0.5 entrance_y:=0.0 entrance_yaw_deg:=0).
       The rows are driven by the real vision nav only (camera + model;
       needs agbot_vision_nav/config/exported_best.pt or model_path).

       ⚠ Start with gps:=false on the sim. AMCL owns map->odom here, and
       agbot_gps_nav's ekf_map would publish it too. -->

  <arg name="map_file" default="$(find agbot_nav)/maps/field.yaml"/>

  <!-- Where the robot is when this starts (map frame). Defaults: the field
       world's start, facing north with the corn on its right. On the robot
       this is the operator's 2D Pose Estimate (or, later, an RTK fix). -->
  <arg name="initial_x"   default="-7.92"/>
  <arg name="initial_y"   default="-1.30"/>
  <arg name="initial_yaw" default="1.5917"/>

  <!-- Row entrance, MAP frame; yaw is the row bearing. BLANK (default) =
       pick it in RViz with 2D Nav Goal, as often as you like. ⚠ While this
       launch runs, 2D Nav Goal NEVER drives move_base directly: the click
       goes to the supervisor, which checks the arrival and hands over. -->
  <arg name="entrance_x"       default=""/>
  <arg name="entrance_y"       default=""/>
  <arg name="entrance_yaw_deg" default="0.0"/>
  <!-- The rows' bearing in THIS map (deg, either direction). A clicked arrow
       within max_bearing_snap_deg of it is snapped onto it, anything further
       off is refused: the click picks the row, the field fixes the angle
       (deploy_fsm.py has the sim run where a 12 deg click ended a row 2.7 m
       early). Default 0 = the field world, rows east-west. ⚠ On your own
       map, set it (or blank to trust the arrow): a wrong value refuses every
       goal with a message saying so. -->
  <arg name="row_bearing_deg"      default="0"/>
  <arg name="max_bearing_snap_deg" default="30"/>
  <!-- move_base stops this far BEFORE the entrance, on its axis; vision nav
       drives the rest. Corn leaves reach ~0.6 m into the headland and the
       costmap marks them (deploy_fsm.py has the measurement). -->
  <arg name="entrance_standoff" default="0.7"/>

  <!-- Trailer leg, OFF (0) by default: the robot is set down by hand and
       the sequence starts at LOCALIZE. A positive value reverses that many
       metres blind before localizing (off a ramp). -->
  <arg name="reverse_distance" default="0.0"/>
  <arg name="rviz"             default="false"/>
  <arg name="return_enabled"   default="true"/>
  <!-- move_base top speed (m/s) on the way to the row and back; blank =
       move_base.yaml (0.5). Indoors on the robot: 0.3. -->
  <arg name="transit_speed"    default=""/>
  <!-- false with a map YOU built (transit.launch explains). -->
  <arg name="plan_on_map"      default="true"/>

  <arg name="sim"            default="false"/>
  <arg name="num_rows"       default="3"/>
  <!-- left: from the field world's default corridor (the north block's
       SOUTHERNMOST) the other two corridors are to the north; turning right
       there leads into the cross alley. Match it to the corridor you pick. -->
  <arg name="first_turn_direction" default="left"/>
  <arg name="rear_camera_enabled"  default="true"/>
  <arg name="model_path"     default=""/>
  <!-- In-row and headland speeds; blank = vision nav's params.yaml. -->
  <arg name="linear_x_cruise"  default=""/>
  <arg name="angular_z_max"    default=""/>
  <arg name="traverse_speed"   default=""/>
  <arg name="exit_clear_speed" default=""/>
  <!-- Real robot with the spare Brio in front (operator panel's frame
       source); blank = vision_nav.launch's own topic choice. -->
  <arg name="camera_topic"               default=""/>
  <arg name="camera_topic_is_compressed" default=""/>

  <include file="$(find agbot_nav)/launch/transit.launch">
    <arg name="map_file"    value="$(arg map_file)"/>
    <arg name="initial_x"   value="$(arg initial_x)"/>
    <arg name="initial_y"   value="$(arg initial_y)"/>
    <arg name="initial_yaw" value="$(arg initial_yaw)"/>
    <arg name="rviz"        value="$(arg rviz)"/>
    <arg name="max_vel"     value="$(arg transit_speed)"/>
    <arg name="simple_goal" value="false"/>
    <arg name="plan_on_map" value="$(arg plan_on_map)"/>
  </include>

  <include file="$(find agbot_vision_nav)/launch/vision_nav.launch">
    <arg name="sim"              value="$(arg sim)"/>
    <arg name="start_enabled"    value="false"/>
    <arg name="mission_enabled"  value="true"/>
    <arg name="num_rows"         value="$(arg num_rows)"/>
    <arg name="first_turn_direction" value="$(arg first_turn_direction)"/>
    <arg name="rear_camera_enabled"  value="$(arg rear_camera_enabled)"/>
    <arg name="model_path"       value="$(arg model_path)"
         if="$(eval arg('model_path') != '')"/>
    <arg name="linear_x_cruise"  value="$(arg linear_x_cruise)"/>
    <arg name="angular_z_max"    value="$(arg angular_z_max)"/>
    <arg name="traverse_speed"   value="$(arg traverse_speed)"/>
    <arg name="exit_clear_speed" value="$(arg exit_clear_speed)"/>
    <arg name="camera_topic"     value="$(arg camera_topic)"
         if="$(eval arg('camera_topic') != '')"/>
    <arg name="camera_topic_is_compressed" value="$(arg camera_topic_is_compressed)"
         if="$(eval arg('camera_topic_is_compressed') != '')"/>
  </include>

  <!-- SIM ONLY: the parked sim Jackal slides forward, invisible to odometry
       and so to AMCL; every 2D Nav Goal re-seeds AMCL from Gazebo truth
       (scripts/sim_creep_guard.py has the measurement). -->
  <node if="$(arg sim)" name="sim_creep_guard"
        pkg="agbot_nav" type="sim_creep_guard.py" output="screen"/>

  <node name="deploy_supervisor" pkg="agbot_nav" type="deploy_supervisor.py"
        output="screen" required="true">
    <param name="entrance_x"       value="$(arg entrance_x)"/>
    <param name="entrance_y"       value="$(arg entrance_y)"/>
    <param name="entrance_yaw_deg" value="$(arg entrance_yaw_deg)"/>
    <param name="entrance_standoff" value="$(arg entrance_standoff)"/>
    <param name="reverse_distance" value="$(arg reverse_distance)"/>
    <param name="return_enabled"   value="$(arg return_enabled)"/>
    <param name="row_bearing_deg"  value="$(arg row_bearing_deg)"/>
    <param name="max_bearing_snap_deg" value="$(arg max_bearing_snap_deg)"/>
  </node>
</launch>
