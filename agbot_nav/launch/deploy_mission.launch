<launch>
  <!-- THE WHOLE DEPLOYMENT on the LiDAR stack:
         reverse off the trailer -> AMCL localizes -> move_base to the row
         entrance -> vision nav drives the rows -> move_base back to the
         drop-off point.
       Sequenced by deploy_supervisor.py (decisions in deploy_fsm.py).

       Sim (the `field` world, agbot_bringup/config/agbot_field_layout.yaml):
         rosrun agbot_bringup switch_maize_world.sh field
         roslaunch agbot_bringup agbot_gazebo.launch lidar:=true rviz:=false \
           x:=-7.92 y:=-1.30 z:=0.35 yaw:=1.5917
         roslaunch agbot_nav deploy_mission.launch vision_standin:=true rviz:=true
       Every default below is that world's. With your own SLAM map, pass
       map_file, initial_* (0 0 0 if you start where mapping started) and the
       entrance in THAT map's frame (read it off RViz with "Publish Point").

       ⚠ Start with gps:=false on the sim. AMCL owns map->odom here, and
       agbot_gps_nav's ekf_map would publish it too. -->

  <arg name="map_file" default="$(find agbot_nav)/maps/field.yaml"/>

  <!-- Where the robot is when this starts (map frame). Defaults: the field
       world's start, facing north with the corn on its right. On the robot
       this is the operator's 2D Pose Estimate (or, later, an RTK fix). -->
  <arg name="initial_x"   default="-7.92"/>
  <arg name="initial_y"   default="-1.30"/>
  <arg name="initial_yaw" default="1.5917"/>

  <!-- Row entrance, MAP frame; yaw is the row bearing. Default: the field
       world's entrance, the north block's 3rd/4th-row corridor, facing east. -->
  <arg name="entrance_x"       default="-0.5"/>
  <arg name="entrance_y"       default="0.0"/>
  <arg name="entrance_yaw_deg" default="0.0"/>
  <!-- move_base stops this far BEFORE the entrance, on its axis; vision nav
       drives the rest. Corn leaves reach ~0.6 m into the headland and the
       costmap marks them (deploy_fsm.py has the measurement). -->
  <arg name="entrance_standoff" default="0.7"/>

  <!-- Trailer leg, OFF (0) by default: the robot is set down by hand and
       the sequence starts at LOCALIZE. A positive value reverses that many
       metres blind before localizing (off a ramp). -->
  <arg name="reverse_distance" default="0.0"/>
  <arg name="rviz"             default="false"/>
  <arg name="return_enabled"   default="true"/>

  <!-- Row mission. vision_standin:=true replaces vision nav with a blind
       straight-line stand-in (SIM ONLY: the laptop cannot run the model). -->
  <arg name="vision_standin" default="false"/>
  <!-- Stand-in only: steer from Gazebo ground truth (a perfect vision nav),
       and how far to drive — through the row AND out into the far
       headland, where a real row mission ends. -->
  <arg name="standin_oracle"       default="true"/>
  <arg name="standin_row_distance" default="10.7"/>  <!-- field world: 8 m row + standoff + 1.5 m out -->
  <arg name="sim"            default="false"/>
  <arg name="num_rows"       default="3"/>
  <arg name="first_turn_direction" default="right"/>
  <arg name="rear_camera_enabled"  default="true"/>
  <arg name="model_path"     default=""/>

  <include file="$(find agbot_nav)/launch/transit.launch">
    <arg name="map_file"    value="$(arg map_file)"/>
    <arg name="initial_x"   value="$(arg initial_x)"/>
    <arg name="initial_y"   value="$(arg initial_y)"/>
    <arg name="initial_yaw" value="$(arg initial_yaw)"/>
    <arg name="rviz"        value="$(arg rviz)"/>
  </include>

  <group if="$(arg vision_standin)">
    <node name="vision_nav_node" pkg="agbot_nav" type="vision_standin.py" output="screen">
      <param name="oracle"       value="$(arg standin_oracle)"/>
      <param name="row_distance" value="$(arg standin_row_distance)"/>
      <param name="axis_x"       value="$(arg entrance_x)"/>
      <param name="axis_y"       value="$(arg entrance_y)"/>
      <param name="axis_yaw_deg" value="$(arg entrance_yaw_deg)"/>
    </node>
  </group>
  <group unless="$(arg vision_standin)">
    <include file="$(find agbot_vision_nav)/launch/vision_nav.launch">
      <arg name="sim"              value="$(arg sim)"/>
      <arg name="start_enabled"    value="false"/>
      <arg name="mission_enabled"  value="true"/>
      <arg name="num_rows"         value="$(arg num_rows)"/>
      <arg name="first_turn_direction" value="$(arg first_turn_direction)"/>
      <arg name="rear_camera_enabled"  value="$(arg rear_camera_enabled)"/>
      <arg name="model_path"       value="$(arg model_path)"
           if="$(eval arg('model_path') != '')"/>
    </include>
  </group>

  <node name="deploy_supervisor" pkg="agbot_nav" type="deploy_supervisor.py"
        output="screen" required="true">
    <param name="entrance_x"       value="$(arg entrance_x)"/>
    <param name="entrance_y"       value="$(arg entrance_y)"/>
    <param name="entrance_yaw_deg" value="$(arg entrance_yaw_deg)"/>
    <param name="entrance_standoff" value="$(arg entrance_standoff)"/>
    <param name="reverse_distance" value="$(arg reverse_distance)"/>
    <param name="return_enabled"   value="$(arg return_enabled)"/>
  </node>
</launch>
