<launch>
  <!-- Build a 2D map. Drive a lap (RViz drive handle, joystick, or
       move_base:=true and "2D Nav Goal" clicks), then save it:
         rosrun agbot_nav save_map.sh my_field
       which runs map_saver AND pads the map (see save_map.sh for why).

       slam:=slam_toolbox (default) or slam:=gmapping: two different SLAM
       algorithms, same /scan in and /map out; try both.

       The map's frame is wherever the robot was when mapping STARTED: (0, 0)
       is that spot and x points the way it faced. Remember that pose: it is
       the initial pose to give AMCL when you start there again.

       ⚠ The SLAM node publishes map->odom. Nothing else may: not amcl, and
       not agbot_gps_nav's ekf_map (start the sim with gps:=false). -->
  <arg name="slam"        default="slam_toolbox"/>
  <arg name="cloud_topic" default="/ns1/velodyne_points"/>
  <arg name="move_base"   default="false"/>
  <arg name="rviz"        default="false"/>

  <include file="$(find agbot_nav)/launch/scan.launch">
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
  </include>

  <node if="$(eval slam == 'slam_toolbox')" pkg="slam_toolbox"
        type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam file="$(find agbot_nav)/config/slam_toolbox_mapping.yaml" command="load"/>
  </node>

  <node if="$(eval slam == 'gmapping')" pkg="gmapping" type="slam_gmapping"
        name="slam_gmapping" output="screen">
    <rosparam file="$(find agbot_nav)/config/gmapping.yaml" command="load"/>
    <remap from="scan" to="/scan"/>
  </node>

  <node if="$(arg rviz)" name="nav_rviz" pkg="rviz" type="rviz"
        args="-d $(find agbot_nav)/rviz/nav.rviz"/>

  <include if="$(arg move_base)" file="$(find agbot_nav)/launch/move_base.launch">
    <arg name="mapping" value="true"/>
  </include>
</launch>
