<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    AgBot cameras, plus the optional 3D LiDAR.
    Included via JACKAL_URDF_EXTRAS into jackal.urdf.xacro.
    xacro arg lidar:=true (default false) also includes
    agbot_lidar.urdf.xacro, the horizontal Velodyne on its housing.
    Parent link: mid_mount (top-centre of Jackal chassis).

    Layout (all offsets relative to mid_mount):

      camera_link        — forward sensor on the front deck at
                           xyz="0.19  0  0.025"

      camera_rear_link   — rear sensor MIRRORED about the robot centre at
                           xyz="-0.19  0  0.025", yawed 180°. Same height as
                           the front camera, same inset from its deck edge, so
                           the reverse view matches the forward view.

      *_optical_frame    — CV convention (z forward, x right, y down)
                           used as the image header frame_id
  -->

  <!-- Camera sensor body dimensions (m) -->
  <xacro:property name="cam_length" value="0.01"/>
  <xacro:property name="cam_width"  value="0.10"/>
  <xacro:property name="cam_height" value="0.05"/>

  <!-- ─── Camera macro: body + optical frame + Gazebo sensor ──── -->
  <!-- name=camera keeps all historical names/topics of the forward
       camera (camera_link, base_camera_joint, camera_optical_frame,
       sensor agbot_camera, plugin camera_controller, /camera/*). -->
  <xacro:macro name="agbot_cam" params="name xyz rpy">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="${cam_length} ${cam_width} ${cam_height}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <geometry>
          <box size="${cam_length} ${cam_width} ${cam_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia
          ixx="${0.05*(cam_width*cam_width   + cam_height*cam_height)/12}"
          ixy="0" ixz="0"
          iyy="${0.05*(cam_length*cam_length + cam_height*cam_height)/12}"
          iyz="0"
          izz="${0.05*(cam_length*cam_length + cam_width*cam_width)/12}"/>
      </inertial>
    </link>

    <joint name="base_${name}_joint" type="fixed">
      <parent link="mid_mount"/>
      <child  link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Optical frame, CV convention: z forward, x right, y down.
         Transform: -90° around X, then -90° around Z (relative to the
         camera link, so it is identical for front and rear cameras). -->
    <link name="${name}_optical_frame"/>

    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child  link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/DarkGrey</material>

      <sensor type="camera" name="agbot_${name}">
        <update_rate>30.0</update_rate>

        <camera name="head">
          <!-- 80° horizontal FOV — wide enough to see row boundaries -->
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>

        <plugin name="${name}_controller" filename="libgazebo_ros_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30.0</updateRate>
          <cameraName>${name}</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>${name}_optical_frame</frameName>
          <distortionK1>0.0</distortionK1>
          <distortionK2>0.0</distortionK2>
          <distortionK3>0.0</distortionK3>
          <distortionT1>0.0</distortionT1>
          <distortionT2>0.0</distortionT2>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ─── Forward camera (LOW deck mount — the standard now) ──── -->
  <!-- On the front deck, lens just inside the +0.210 m front edge of the
       chassis (parent stays mid_mount). z=0.025 puts the 0.05 m-tall camera
       body's bottom on the deck plane. The low mount sees the row
       boundaries closer in and matches the physical GPU robot. (The old
       20 cm camera stand, camera_mount_link, was removed 2026-10-14; it is
       in git history.) -->
  <xacro:agbot_cam name="camera" xyz="0.19 0 0.025" rpy="0 0 0"/>

  <!-- ─── Rear camera (blocked-row back-out) ──────────────────── -->
  <!-- MIRROR of the forward camera about the robot centre: same z, same
       0.02 m inset from its deck edge, yawed 180°. The back-out steers from
       this camera reusing the MPC with UNCHANGED signs (image mirror ×
       reversed motion cancel), which assumes the reverse view is the
       geometric twin of the forward view — a different height or inset would
       break that assumption and mistune the reverse leg.
       Publishes /camera_rear/image_raw, frame camera_rear_optical_frame. -->
  <xacro:agbot_cam name="camera_rear" xyz="-0.19 0 0.025" rpy="0 0 3.14159265"/>

  <!-- ─── 3D LiDAR (opt-in) ────────────────────────────────────── -->
  <!-- Off by default: a simulated Velodyne costs RTF the vision-nav runs
       cannot spare. load_robot_description.sh forwards lidar:=true. -->
  <xacro:arg name="lidar" default="false"/>
  <xacro:if value="$(arg lidar)">
    <xacro:include filename="$(find agbot_bringup)/urdf/agbot_lidar.urdf.xacro"/>
  </xacro:if>

</robot>
