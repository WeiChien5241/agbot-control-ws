<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    AgBot forward camera with physical mount stand.
    Included via JACKAL_URDF_EXTRAS into jackal.urdf.xacro.
    Parent link: mid_mount (top-centre of Jackal chassis).

    Layout (all offsets relative to mid_mount):

      camera_mount_link  — 20×5×20 cm stand
                           front face flush with x=0, body extends to x=-0.20 m
                           centre at xyz="-0.10  0  0.10"

      camera_link        — sensor origin at xyz="0  0  0.225"
                           (camera bottom = 0.20 m = top of stand)

      camera_optical_frame — CV convention (z forward, x right, y down)
                             used as the image header frame_id
  -->

  <!-- Mount stand dimensions (m) -->
  <xacro:property name="mount_length" value="0.05"/>
  <xacro:property name="mount_width"  value="0.20"/>
  <xacro:property name="mount_height" value="0.20"/>

  <!-- Camera sensor body dimensions (m) -->
  <xacro:property name="cam_length" value="0.01"/>
  <xacro:property name="cam_width"  value="0.10"/>
  <xacro:property name="cam_height" value="0.05"/>

  <!-- half-height shortcuts -->
  <xacro:property name="cam_z" value="0.225"/>  <!-- 0.20 + cam_height/2 -->

  <!-- ─── Mount stand ─────────────────────────────────────────── -->
  <link name="camera_mount_link">
    <visual>
      <geometry>
        <box size="${mount_length} ${mount_width} ${mount_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${mount_length} ${mount_width} ${mount_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${0.3*(mount_width*mount_width   + mount_height*mount_height)/12}"
        ixy="0" ixz="0"
        iyy="${0.3*(mount_length*mount_length + mount_height*mount_height)/12}"
        iyz="0"
        izz="${0.3*(mount_length*mount_length + mount_width*mount_width)/12}"/>
    </inertial>
  </link>

  <!-- centre of box: x=-0.10 m (front face at x=0, extends behind),
                      y= 0.00 m (centred),
                      z= 0.10 m (half of 0.20 m height, rests on platform) -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="mid_mount"/>
    <child  link="camera_mount_link"/>
    <origin xyz="-0.10 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ─── Camera body ─────────────────────────────────────────── -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${cam_length} ${cam_width} ${cam_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${cam_length} ${cam_width} ${cam_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${0.05*(cam_width*cam_width   + cam_height*cam_height)/12}"
        ixy="0" ixz="0"
        iyy="${0.05*(cam_length*cam_length + cam_height*cam_height)/12}"
        iyz="0"
        izz="${0.05*(cam_length*cam_length + cam_width*cam_width)/12}"/>
    </inertial>
  </link>

  <!-- camera centre: x=0, y=0 (robot centre), z=cam_z above mid_mount.
       Camera bottom (cam_z - cam_height/2 = 0.20 m) sits on stand top. -->
  <joint name="base_camera_joint" type="fixed">
    <parent link="mid_mount"/>
    <child  link="camera_link"/>
    <origin xyz="0 0 ${cam_z}" rpy="0 0 0"/>
  </joint>

  <!-- ─── Optical frame (CV convention) ───────────────────────── -->
  <!-- z forward, x right, y down.
       Transform: -90° around X, then -90° around Z. -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- ─── Gazebo sensor and material ──────────────────────────── -->
  <gazebo reference="camera_mount_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>

    <sensor type="camera" name="agbot_camera">
      <update_rate>30.0</update_rate>

      <camera name="head">
        <!-- 80° horizontal FOV — wide enough to see row boundaries -->
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>

      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_optical_frame</frameName>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

</robot>
