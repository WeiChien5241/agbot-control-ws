<?xml version="1.0"?>
<!--
  Lightweight Gazebo world for P-AgBot row-centering simulation.
  4 rows of corn on flat ground — no heightmap terrain.

  Layout:
    Row 0: y = -1.125 m  (outer left)
    Row 1: y = -0.375 m  (inner left)   ← left wall of primary corridor
    Row 2: y =  0.375 m  (inner right)  ← right wall of primary corridor
    Row 3: y =  1.125 m  (outer right)

    Robot spawns at x=-2.0, y=0.0, facing +x (before row start at x=0).
    Primary corridor width: 0.75 m (y = -0.375 to +0.375).
    Row spacing: 0.75 m.  In-row spacing: 0.30 m.
    40 positions per row, 4 missing = 36 corns per row = 144 total.

  Model path: virtual_maize_field/models/ (set via GAZEBO_MODEL_PATH in launch).
-->
<sdf version="1.6">
  <world name="agbot_corn_rows">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Sky with clouds so the segmentation model (trained on dirt/sky/corn)
         sees a real sky region instead of a flat grey background. -->
    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Dirt-textured ground (custom model in agbot_bringup/models) replaces
         the default grey ground_plane so the ground segments as soil. -->
    <include>
      <uri>model://dirt_ground</uri>
    </include>

    <!-- Row 0: y = -1.125 m -->
    <include>
      <uri>model://maize_01</uri>
      <name>maize_r0_c00</name>
      <pose>0.00 -1.125 0.0  0 0 0.10</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://maize_02</uri>
      <name>maize_r0_c01</name>
      <pose>0.30 -1.125 0.0  0 0 -0.15</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://maize_01</uri>
      <name>maize_r0_c02</name>
      <pose>0.60 -1.125 0.0  0 0 0.08</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://maize_02</uri>
      <name>maize_r0_c03</name>
      <pose>0.90 -1.125 0.0  0 0 -0.22</pose>
      <static>true</static>
    </include>
    <include>
      <uri>model://maize_01</uri>
      <name>maize_r0_c04</name>
      <pose>1.20 -1.125 0.0  0 0 0.17</pose>
