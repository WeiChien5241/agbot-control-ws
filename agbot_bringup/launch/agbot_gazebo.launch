<?xml version="1.0"?>
<launch>

  <!-- Show Gazebo GUI window; pass gui:=false for headless runs -->
  <arg name="gui" default="true"/>

  <!-- Spawn pose in the corn field. For virtual_maize_field worlds the
       correct pose is generated per-world: read it from
       ~/.ros/virtual_maize_field/robot_spawner.launch (also printed by
       scripts/generate_small_maize_world.sh and switch_maize_world.sh) and
       pass x:= y:= z:= yaw:= if it differs from these defaults.
       Defaults below are for the SMALL maize world (agbot_maize_small.yaml,
       seed 42 so the pose is stable across regenerations).
       Other worlds:
         full maize snapshot:  x=3.16 y=-9.31 z=0.36 yaw=1.791 -->
  <arg name="x" default="0.777"/>
  <arg name="y" default="-4.331"/>
  <arg name="z" default="0.35"/>
  <!-- yaw aligns the robot with the row direction at this spawn point.
       Roll/pitch (~1 deg terrain slope) are not settable via spawn_jackal;
       the robot settles onto the terrain under gravity. -->
  <arg name="yaw" default="1.536"/>

  <!-- Set false to disable teleop -->
  <arg name="joystick" default="true"/>

  <!-- Ensure Gazebo can resolve model://maize_01, model://maize_02 (from
       virtual_maize_field). Sourcing the workspace normally handles this via
       package.xml exports; this env tag is a belt-and-suspenders fallback that
       works without a rebuild. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find agbot_bringup)/models:$(find virtual_maize_field)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <!-- 1. World: whichever virtual_maize_field world is active in
       ~/.ros/virtual_maize_field/ (swap snapshots with
       scripts/switch_maize_world.sh small|full).
       PREREQUISITE: the world must exist — generate it with
         scripts/generate_small_maize_world.sh
       or  rosrun virtual_maize_field generate_world.py
       simulation.launch only starts Gazebo with that world; the robot is
       still spawned by section 2 below. -->
  <include file="$(find virtual_maize_field)/launch/simulation.launch">
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="paused"       value="false"/>
    <arg name="headless"     value="false"/>
  </include>

  <!-- 2. Load Jackal robot description, controllers, teleop, and spawn
       the model into Gazebo. Does NOT start a second Gazebo instance.
       Note: this sets /robot_description WITHOUT the camera extras;
       it is overridden by the <param> block below. -->
  <include file="$(find jackal_gazebo)/launch/spawn_jackal.launch">
    <arg name="x"        value="$(arg x)"/>
    <arg name="y"        value="$(arg y)"/>
    <arg name="z"        value="$(arg z)"/>
    <arg name="yaw"      value="$(arg yaw)"/>
    <arg name="joystick" value="$(arg joystick)"/>
  </include>

  <!-- 3. Override /robot_description with camera-inclusive URDF.
       Placed AFTER spawn_jackal so this param wins (ROS1 processes
       all <param> commands in order before any node starts, so
       robot_state_publisher and spawn_model both read this version).
       The script sets JACKAL_URDF_EXTRAS before running xacro so the
       $(optenv JACKAL_URDF_EXTRAS) hook in jackal.urdf.xacro picks
       up our camera file. -->
  <param name="robot_description"
         command="$(find agbot_bringup)/scripts/load_robot_description.sh
                  $(find agbot_bringup)/urdf/agbot_camera.urdf.xacro
                  $(find jackal_description)/urdf/jackal.urdf.xacro" />

  <!-- 4. RViz: RobotModel + TF + live camera feed from /camera/image_raw -->
  <node name="rviz" pkg="rviz" type="rviz" output="screen"
        args="-d $(find agbot_bringup)/rviz/urdf_config.rviz"/>

</launch>
