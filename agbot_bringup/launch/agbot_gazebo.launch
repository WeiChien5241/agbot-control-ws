<?xml version="1.0"?>
<launch>

  <!-- Show Gazebo GUI window; pass gui:=false for headless runs -->
  <arg name="gui" default="true"/>

  <!-- Spawn position in the corn field.
       x=-2.0 places the robot 2 m before the row start (corn begins at x=0).
       y=0.0  centres the robot in the primary corridor (between rows at y=±0.375).
       z:=0.5 keeps the robot above the ground plane at spawn. -->
  <arg name="x" default="-2.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.5"/>

  <!-- Set false to disable teleop (e.g. when running autonomous control only) -->
  <arg name="joystick" default="true"/>

  <!-- 1. Start Gazebo with our lightweight custom corn-row world.
       OLD (too heavy — heightmap terrain + 615 models):
         <include file="$(find virtual_maize_field)/launch/simulation.launch">
           <arg name="gui" value="$(arg gui)"/>
         </include>
       NEW: flat ground, 4 rows × 36 corns = 144 static models only. -->

  <!-- Ensure Gazebo can resolve model://maize_01, model://maize_02 (from
       virtual_maize_field) and model://dirt_ground (our custom ground model).
       Sourcing the workspace normally handles this via package.xml exports;
       this env tag is a belt-and-suspenders fallback that works without a
       rebuild. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find agbot_bringup)/models:$(find virtual_maize_field)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find agbot_bringup)/worlds/agbot_corn_rows.world"/>
    <arg name="paused"       value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
    <arg name="verbose"      value="false"/>
  </include>

  <!-- 2. Load Jackal robot description, controllers, teleop, and spawn
       the model into Gazebo. Does NOT start a second Gazebo instance.
       Note: this sets /robot_description WITHOUT the camera extras;
       it is overridden by the <param> block below. -->
  <include file="$(find jackal_gazebo)/launch/spawn_jackal.launch">
    <arg name="x"        value="$(arg x)"/>
    <arg name="y"        value="$(arg y)"/>
    <arg name="z"        value="$(arg z)"/>
    <arg name="joystick" value="$(arg joystick)"/>
  </include>

  <!-- 3. Override /robot_description with camera-inclusive URDF.
       Placed AFTER spawn_jackal so this param wins (ROS1 processes
       all <param> commands in order before any node starts, so
       robot_state_publisher and spawn_model both read this version).
       The script sets JACKAL_URDF_EXTRAS before running xacro so the
       $(optenv JACKAL_URDF_EXTRAS) hook in jackal.urdf.xacro picks
       up our camera file. -->
  <param name="robot_description"
         command="$(find agbot_bringup)/scripts/load_robot_description.sh
                  $(find agbot_bringup)/urdf/agbot_camera.urdf.xacro
                  $(find jackal_description)/urdf/jackal.urdf.xacro" />

  <!-- 4. RViz: RobotModel + TF + live camera feed from /camera/image_raw -->
  <node name="rviz" pkg="rviz" type="rviz" output="screen"
        args="-d $(find agbot_bringup)/rviz/urdf_config.rviz"/>

</launch>
