<?xml version="1.0"?>
<sdf version="1.6">
  <model name="dirt_ground">
    <static>true</static>
    <link name="link">
      <!-- Flat collision plane (infinite) so the robot drives on solid ground. -->
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Visual: finite dirt-textured plane covering the field. -->
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>50 50</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://dirt_ground/materials/scripts</uri>
            <uri>model://dirt_ground/materials/textures</uri>
            <name>DirtGround/Diffuse</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
